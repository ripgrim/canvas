  "scenarios": [
    {
      "id": "application.login",
      "title": "The hosted login surface renders its ready state",
      "capabilities": ["application.login"],
      "adapters": ["browser"],
      "assertions": ["login.actions-consistent", "login.brand-visible", "login.disabled-providers-honest"],
      "screenshots": ["ready"],
      "video": false
    },
    {
      "id": "editor.typography",
      "title": "Text controls expose the font catalog",
      "capabilities": ["editor.typography"],
      "adapters": ["browser"],
      "assertions": ["font-picker.catalog-ready", "font-picker.search-focused", "text.inspector-visible"],
      "screenshots": ["font-picker"],
      "video": true
    },
    {
      "id": "editor.transient-move",
      "title": "Selection follows a transient move",
      "capabilities": ["editor.canvas.transient-move", "evidence.infrastructure"],
      "adapters": ["browser"],
      "assertions": ["hud.follows", "model.commits-on-release", "preview.moves-while-held", "viewport.stable"],
      "screenshots": ["before", "held", "after"],
      "video": true
    },
    {
      "id": "editor.frame-wiggle-flex",
      "title": "A red flex frame stays synchronized while moving",
      "capabilities": ["editor.canvas.transient-move", "evidence.infrastructure"],
      "adapters": ["browser"],
      "assertions": ["frame.500x500", "hud.follows-wiggle", "flex-control.stays-mounted", "flex-control.disables-while-held", "flex-control.recovers-on-release", "fill.red", "layout.flex", "model.commits"],
      "screenshots": ["created", "held-flex-control", "wiggled", "red", "flex"],
      "video": true
    },
    {
      "id": "editor.node-overlay",
      "title": "A selected frame keeps its complete overlay",
      "capabilities": ["editor.canvas.selection-overlay", "evidence.infrastructure"],
      "adapters": ["browser"],
      "assertions": ["overlay.matches-node", "overlay.resize-handles", "overlay.rotation-handles", "overlay.survives-reconnect", "overlay.recovers-after-reconnect", "overlay.clears-on-deselect", "recording.node-crop"],
      "screenshots": ["overlay", "overlay-reconnecting", "overlay-dark", "overlay-mobile"],
      "video": true
    },
    {
      "id": "editor.clipboard-drop",
      "title": "Dropped text lands at the canvas pointer",
      "capabilities": ["editor.clipboard-drop", "evidence.infrastructure"],
      "adapters": ["browser"],
      "assertions": ["drop.canvas-only", "drop.pointer-placement", "drop.preview-visible"],
      "screenshots": ["dropped"],
      "video": false
    },
    {
      "id": "editor.component-system",
      "title": "A canvas component becomes an isolated reusable instance",
      "capabilities": ["editor.component-system", "evidence.infrastructure"],
      "adapters": ["browser"],
      "assertions": ["component.created-once", "component.creation-opens-details", "component.properties-authored", "component.materials-projected", "component.docs-visible", "component.instance-placed", "component.instance-isolated", "component.interactions-previewed", "component.variant-sheet-generated", "component.undo-restores-semantics"],
      "screenshots": ["materials", "docs", "instance", "variant-sheet", "slot-playground", "slot-placed", "interaction-hover", "interaction-pressed"],
      "video": true
    },
    {
      "id": "editor.theme-token-color",
      "title": "A theme color opens from its swatch without stealing opacity editing",
      "capabilities": ["editor.theme-tokens", "evidence.infrastructure"],
      "adapters": ["browser"],
      "assertions": ["theme.color-preview-opens", "theme.opacity-independent", "theme.keyboard-restores-focus", "theme.portal-follows-mode"],
      "screenshots": ["picker-light", "opacity-42", "picker-dark"],
      "video": true
    },
    {
      "id": "editor.mobile-properties-menu",
