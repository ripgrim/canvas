      "capabilities": ["editor.mobile-properties", "evidence.infrastructure"],
      "adapters": ["browser"],
      "assertions": ["mobile.properties-opens", "mobile.menu-owned", "mobile.escape-restores-focus", "mobile.menu-commits"],
      "screenshots": ["menu-open", "menu-committed"],
