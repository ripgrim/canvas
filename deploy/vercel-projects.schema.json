{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "repository", "gitDeployments", "projects", "externalServices"],
  "properties": {
    "$schema": { "type": "string" },
    "scope": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "pattern": "^https://github\\.com/" },
    "gitDeployments": { "const": "disabled" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "name", "rootDirectory", "framework", "buildCommand", "environment"],
        "properties": {
          "service": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "rootDirectory": { "type": "string", "pattern": "^apps/[a-z0-9-]+$" },
          "framework": { "enum": ["vite", "other"] },
          "buildCommand": { "type": "string", "minLength": 1 },
          "outputDirectory": { "type": "string", "minLength": 1 },
          "environment": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } }
        }
      }
    },
    "externalServices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "platform", "reason"],
        "properties": {
          "service": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

