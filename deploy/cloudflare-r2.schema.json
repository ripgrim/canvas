{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comp-canvas.local/schemas/cloudflare-r2.schema.json",
  "title": "Comp Canvas Cloudflare R2 resources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accountId",
    "binding",
    "environments",
    "privacy",
    "lifecycleRules"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "accountId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "binding": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "preview", "production"],
      "properties": {
        "local": { "$ref": "#/$defs/environment" },
        "preview": { "$ref": "#/$defs/environment" },
        "production": { "$ref": "#/$defs/environment" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r2DevUrl", "customDomains"],
      "properties": {
        "r2DevUrl": { "const": false },
        "customDomains": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "lifecycleRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "prefix", "expireDays"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "prefix": { "type": "string", "minLength": 1 },
          "expireDays": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "bucketName", "apiOrigin", "allowedOrigins"],
      "properties": {
        "mode": { "enum": ["simulation", "remote"] },
        "bucketName": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])$"
        },
        "location": { "enum": ["weur", "eeur", "apac", "wnam", "enam", "oc"] },
        "storageClass": { "enum": ["Standard", "InfrequentAccess"] },
        "apiOrigin": { "type": "string", "format": "uri" },
        "allowedOrigins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
