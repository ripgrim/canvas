# Hosted auth service only. Paste the exact PlanetScale Postgres connection
# string from its Connect dialog. Never expose it through Vite or Electron preload.
DATABASE_URL="postgresql://<username>:<password>@<host>:6432/postgres?sslmode=verify-full&sslrootcert=system"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://127.0.0.1:4320"

# GitHub OAuth app credentials for account sign-in only.
# Set its authorization callback URL to:
# http://127.0.0.1:4320/api/auth/callback/github
GITHUB_CLIENT_ID="replace-with-github-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-oauth-client-secret"

# Hosted surfaces. Login is separate from the editor and API, matching the
# production subdomain boundary without requiring a deployment for local work.
LOGIN_URL="http://127.0.0.1:4319"
APP_URL="http://127.0.0.1:4317"
AUTH_TRUSTED_ORIGINS=""
# Production only. This DNS parent must contain the HTTPS auth, login, editor,
# and WSS sync hosts. Better Auth sets the shared session cookie HttpOnly,
# Secure, SameSite=Lax, and Path=/. Leave this empty for loopback development.
# Example for api.canvas.example.com and sync.canvas.example.com: .canvas.example.com
AUTH_COOKIE_DOMAIN=""
# Optional environment-specific namespace. Use a distinct value for staging
# when a production parent-domain cookie can also reach the staging hostname.
AUTH_COOKIE_PREFIX=""
VITE_API_URL="http://127.0.0.1:4320"
VITE_APP_URL="http://127.0.0.1:4317"
VITE_API_ORIGIN="http://127.0.0.1:4320"
VITE_LOGIN_ORIGIN="http://127.0.0.1:4319"
VITE_PREVIEW_ORIGIN="http://127.0.0.1:4318"
VITE_ASSETS_ORIGIN="http://127.0.0.1:4322"
VITE_SYNC_ORIGIN="ws://127.0.0.1:4321"
VITE_DATABUDDY_CLIENT_ID=""
THUMBNAIL_RENDERER_ORIGIN="http://127.0.0.1:4323"

# Electron main process only. These are public origins, not credentials.
DESIGN_EDITOR_AUTH_URL="http://127.0.0.1:4320"
DESIGN_EDITOR_LOGIN_URL="http://127.0.0.1:4319"
DESIGN_EDITOR_PREVIEW_URL="http://127.0.0.1:4318"
DESIGN_EDITOR_ASSETS_URL="http://127.0.0.1:4322"

# Internal service authentication. Generate independent values with:
# openssl rand -base64 48
# Never prefix server credentials with VITE_ or pass them to Vite or Electron.
API_SERVICE_TOKEN=""
COLLABORATION_ADMISSION_SERVICE_TOKEN=""
COLLABORATION_BUILD_ID="0.1.0"
SYNC_COORDINATOR_INTERNAL_SECRET=""
SYNC_ROOM_TICKET_SECRET=""
SYNC_ROOM_RUNTIME_ORIGIN="http://127.0.0.1:4325"
SYNC_ROOM_HANDSHAKE_TIMEOUT_MS="5000"
# Optional outside the root dev command. The root command creates a temporary,
# process-owned checkpoint directory and removes it during shutdown.
SYNC_ROOM_CHECKPOINT_DIR=""
UPLOAD_INTENT_SECRET=""
THUMBNAIL_SERVICE_TOKEN=""
THUMBNAIL_JOB_TRIGGER_TOKEN=""
HOSTED_PREVIEW_BUILDER_IMAGE=""
HOSTED_DOCS_VALIDATOR_IMAGE=""
HOSTED_DOCS_VALIDATOR_PROFILE=""
# Generated by the local registry command. Hosted API and thumbnail renderer
# deployments must receive the same verified value.
CANVAS_VERIFIED_REGISTRY_FINGERPRINT=""
API_ORIGIN="http://127.0.0.1:4320"
ASSETS_ORIGIN="http://127.0.0.1:4322"
ALLOWED_ORIGINS="http://127.0.0.1:4317,http://127.0.0.1:4319"
