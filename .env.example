# Hosted auth service only. Paste the exact PlanetScale Postgres connection
# string from its Connect dialog. Never expose it through Vite or Electron preload.
DATABASE_URL="postgresql://<username>:<password>@<host>:6432/postgres?sslmode=verify-full&sslrootcert=system"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4317"

# GitHub OAuth app credentials for account sign-in only.
# Set its authorization callback URL to:
# http://localhost:4317/api/auth/callback/github
GITHUB_CLIENT_ID="replace-with-github-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-oauth-client-secret"

# Electron main process only. This must match BETTER_AUTH_URL.
DESIGN_EDITOR_AUTH_URL="http://localhost:4317"
