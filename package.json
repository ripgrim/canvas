{
  "name": "design-editor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint:contracts": "node scripts/check-contracts.mjs && node scripts/check-runtime-boundaries.mjs",
    "verify": "pnpm lint:contracts && pnpm typecheck && pnpm test && pnpm build",
    "dev:web": "pnpm --filter @canvas/web dev",
    "dev:preview": "pnpm --filter @canvas/web dev:preview"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "fixtures/*"
  ]
}
