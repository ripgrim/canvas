{
  "name": "design-editor",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "version": "node scripts/sync-app-version.mjs",
    "sync:version": "node scripts/sync-app-version.mjs",
    "prebuild": "node scripts/sync-app-version.mjs",
    "build": "node scripts/with-local-registry.mjs -r build",
    "build:thumbnail-renderer:vercel": "node scripts/with-local-registry.mjs --filter @canvas/thumbnail-renderer... build",
    "build:preview:vercel": "node scripts/with-local-registry.mjs --filter @canvas/preview... build",
    "build:package:local": "node scripts/sync-app-version.mjs && node scripts/package-desktop.mjs local",
    "build:package:staging": "node scripts/sync-app-version.mjs && node scripts/package-desktop.mjs staging",
    "build:package:production": "node scripts/sync-app-version.mjs && node scripts/package-desktop.mjs production",
    "build:package:prod": "pnpm build:package:production",
    "dev": "node scripts/dev-cloud.mjs --desktop",
    "dev:cloud": "node scripts/dev-cloud.mjs",
    "dev:check": "node scripts/check-local-services.mjs",
    "test:dev-stack": "node scripts/dev-cloud.mjs --check",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:production": "node scripts/test-production-surfaces.mjs",
    "test:service-topology": "node --test scripts/dev-process-lifecycle.test.mjs && node scripts/test-service-topology.mjs",
    "registry:prepare": "pnpm --filter @canvas/scanner build && pnpm --filter @canvas/sync-protocol... build && pnpm --filter @canvas/preview-runtime build && node scripts/local-registry.mjs",
    "test:local-registry": "pnpm --filter @canvas/scanner build && pnpm --filter @canvas/sync-protocol... build && pnpm --filter @canvas/preview-runtime build && node --test scripts/local-registry.test.mjs",
    "vercel:check": "node scripts/vercel-projects.mjs",
    "vercel:setup": "node scripts/vercel-projects.mjs --apply",
    "vercel:env:staging:check": "node scripts/vercel-staging-env.mjs",
    "vercel:env:staging:apply": "node scripts/vercel-staging-env.mjs --apply",
    "test:vercel-config": "node --test scripts/vercel-projects.test.mjs",
    "test:vercel-env": "node --test scripts/vercel-staging-env.test.mjs",
    "test:deployment-config": "node --test scripts/deployment-environments.test.mjs",
    "test:release-workflows": "node --test scripts/release-workflows.test.mjs",
    "test:update-manifest": "node --test scripts/update-manifest.test.mjs",
    "test:vercel-builds": "node --test scripts/vercel-builds.test.mjs",
    "cloudflare:check": "node scripts/cloudflare-r2.mjs",
    "cloudflare:setup": "node scripts/cloudflare-r2.mjs --apply",
    "cloudflare:deploy:staging": "pnpm --filter @canvas/workers exec wrangler deploy --env preview",
    "updates:deploy:staging": "pnpm --filter @canvas/update-service exec wrangler deploy --env preview",
    "updates:deploy:production": "pnpm --filter @canvas/update-service exec wrangler deploy --env production",
    "sync:deploy:staging": "pnpm --filter @canvas/sync-coordinator exec wrangler deploy --env preview --containers-rollout=immediate && pnpm --filter @canvas/sync-worker exec wrangler deploy --env preview",
    "test:cloudflare-config": "node --test scripts/cloudflare-r2.test.mjs",
    "test:home-auth-parity": "node scripts/test-home-auth-parity.mjs",
    "test:stateful-shadcn": "pnpm --filter @design-editor/stateful-shadcn-fixture typecheck && node tests/stateful-shadcn-runtime.mjs",
    "test:desktop-launch": "pnpm --filter @canvas/desktop test:launch-smoke",
    "infra:check": "pnpm vercel:check && pnpm cloudflare:check",
    "db:up": "docker compose --env-file .env.local up -d --wait postgres",
    "db:setup": "pnpm db:up && pnpm db:migrate",
    "db:migrate": "pnpm db:migrate:auth && pnpm db:migrate:app",
    "db:migrate:auth": "node scripts/local-auth-cli.mjs migrate",
    "db:migrate:app": "node scripts/local-database-cli.mjs",
    "db:generate": "node scripts/local-auth-cli.mjs generate",
    "db:check": "node scripts/local-auth-cli.mjs check",
    "db:shell": "docker compose --env-file .env.local exec postgres psql -U design_editor -d design_editor",
    "db:restart": "docker compose --env-file .env.local restart postgres",
    "db:down": "docker compose --env-file .env.local down",
    "db:logs": "docker compose --env-file .env.local logs -f postgres",
    "db:status": "docker compose --env-file .env.local ps postgres",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint:contracts": "node scripts/check-contracts.mjs && node scripts/check-runtime-boundaries.mjs && node --test scripts/check-hidden-errors.test.mjs && node scripts/check-hidden-errors.mjs",
    "verify": "pnpm lint:contracts && pnpm test:service-topology && pnpm test:local-registry && pnpm test:vercel-config && pnpm test:vercel-env && pnpm test:deployment-config && pnpm test:release-workflows && pnpm test:vercel-builds && pnpm test:cloudflare-config && pnpm typecheck && pnpm test && pnpm test:stateful-shadcn && pnpm --filter @canvas/desktop test:electron-boundary && pnpm --filter @canvas/thumbnail-renderer test && pnpm --filter @canvas/thumbnail-jobs test && pnpm build && pnpm test:desktop-launch",
    "verify:local": "pnpm verify && pnpm test:home-auth-parity && pnpm test:postgres && pnpm test:dev-stack",
    "dev:web": "pnpm --filter @canvas/web dev",
    "dev:preview": "node scripts/with-local-registry.mjs --filter @canvas/web dev:preview"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "auth": "1.7.7",
    "dotenv": "18.0.7",
    "happy-dom": "^21.0.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "fixtures/*"
  ]
}
