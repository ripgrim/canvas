    "@canvas/repo-engine": "workspace:*",
    "@canvas/scanner": "workspace:*",
    "@canvas/sync-protocol": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
