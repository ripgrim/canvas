{
  "name": "@canvas/sync-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./internal-api-authorizer": {
      "types": "./dist/internal-api-authorizer.d.ts",
      "import": "./dist/internal-api-authorizer.js"
    },
    "./postgres-repository": {
      "types": "./dist/postgres-repository.d.ts",
      "import": "./dist/postgres-repository.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "pnpm --filter @canvas/sync-protocol build && pnpm --filter @canvas/cloud-document build && pnpm build && node tests/postgres-acceptance.mjs",
    "dev": "pnpm --filter @canvas/sync-protocol build && pnpm --filter @canvas/cloud-document build && pnpm build && node --watch dist/serve.js",
    "start": "node dist/serve.js"
  },
  "dependencies": {
    "@canvas/cloud-document": "workspace:*",
    "@canvas/sync-protocol": "workspace:*",
    "pg": "8.23.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@canvas/sync-client": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
