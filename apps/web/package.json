{
  "name": "@canvas/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "build": "vite build && node ../../scripts/sanitize-start-shell.mjs",
    "typecheck": "tsc --noEmit",
    "test:file-open-startup": "node tests/file-open-startup.mjs",
    "test:update-visual": "node tests/application-update-visual.mjs",
    "dev:preview": "vite --config vite.preview.config.ts --host 127.0.0.1 --port 4318 --strictPort"
  },
  "dependencies": {
    "@canvas/auth": "workspace:*",
    "@canvas/cloud-client": "workspace:*",
    "@canvas/cloud-document": "workspace:*",
    "@canvas/editor": "workspace:*",
    "@canvas/repo-engine": "workspace:*",
    "@canvas/scanner": "workspace:*",
    "@canvas/preview-runtime": "workspace:*",
    "@canvas/sync-client": "workspace:*",
    "@canvas/sync-protocol": "workspace:*",
    "@canvas/tracking": "workspace:*",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/react-router": "1.170.41",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.2.0",
    "typescript": "^5.9.0"
  }
}
