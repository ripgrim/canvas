    "test": "vitest run",
    "start": "node dist/serve.js"
  },
  "dependencies": {
    "@canvas/cloud-document": "workspace:*",
    "@canvas/database": "workspace:*",
    "@canvas/repo-engine": "workspace:*",
    "@canvas/sync-protocol": "workspace:*",
    "pg": "8.23.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@canvas/sync-client": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
