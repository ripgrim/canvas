{
  "name": "@canvas/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./electron": {
      "types": "./dist/electron.d.ts",
      "import": "./dist/electron.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./hosted": {
      "types": "./dist/hosted.server.d.ts",
      "import": "./dist/hosted.server.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.7",
    "better-auth": "1.7.7",
    "conf": "15.1.0",
    "pg": "8.23.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.1",
    "electron": "^40.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
